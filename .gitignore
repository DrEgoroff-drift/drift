# tests.html — сборка «игра + tests/*.js», пересоздаётся build.ps1 при каждой
# сборке. В отличие от drift.html её незачем открывать двойным кликом из
# репозитория, а вес у неё тот же — полмегабайта шума в каждом коммите.
tests.html
version.json
treplo.html

# стенды docs/*.html собираются docs/mk*.ps1 из drift.html — по два мегабайта каждый, в репозитории им не место
docs/*.html
shot

# кадры для заглавной: docs/mksiteshots.ps1 принимает их в docs/shots и копирует
# в site/shots — в репозитории нужна только копия для сайта
docs/shots/*.webp
docs/ref/

# линейка по чужой модели пишется руками, а не генератором — её храним
!docs/macaw-stand.html

# перегонщик снимков в webp — тоже ручной, не сборка стенда
!docs/towebp.html

# docs/shots/ копит разовые кадры от каждого mk*.ps1-стенда — это черновики
# для разбора на месте (docs/DESIGN-*.md, самокритика), не для репозитория.
# В гите остаются только кадры, на которые ссылаются README.md, ALMANAC.md
# и PLAN-archive.md; для новых можно снова добавить строку-исключение.
docs/shots/*.png
!docs/shots/base-rooms.png
!docs/shots/base.png
!docs/shots/belt.png
!docs/shots/belt2.png
!docs/shots/cantina-types.png
!docs/shots/cantina.png
!docs/shots/cave.png
